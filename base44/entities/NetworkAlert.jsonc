{
  "name": "NetworkAlert",
  "type": "object",
  "properties": {
    "alert_id": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "olt",
        "ont",
        "router",
        "server",
        "link",
        "power"
      ]
    },
    "source_id": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "major",
        "minor",
        "warning",
        "info"
      ],
      "default": "info"
    },
    "category": {
      "type": "string",
      "enum": [
        "connectivity",
        "performance",
        "hardware",
        "security",
        "configuration",
        "power"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "acknowledged",
        "resolved",
        "suppressed"
      ],
      "default": "active"
    },
    "acknowledged_by": {
      "type": "string"
    },
    "acknowledged_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "auto_ticket_created": {
      "type": "boolean",
      "default": false
    },
    "related_ticket_id": {
      "type": "string"
    },
    "affected_customers_count": {
      "type": "number"
    },
    "ai_root_cause": {
      "type": "string"
    },
    "ai_suggested_action": {
      "type": "string"
    },
    "metrics": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "threshold": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "source_type",
    "source_id",
    "severity",
    "title"
  ]
}