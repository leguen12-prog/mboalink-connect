{
  "name": "Customer",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Unique customer identifier (MBL-XXXXX)"
    },
    "customer_type": {
      "type": "string",
      "enum": [
        "residential",
        "business",
        "enterprise"
      ],
      "default": "residential"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "company_name": {
      "type": "string",
      "description": "For business/enterprise customers"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "alternate_phone": {
      "type": "string"
    },
    "national_id": {
      "type": "string"
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "en",
        "fr"
      ],
      "default": "en",
      "description": "Customer's preferred language for communications"
    },
    "address": {
      "type": "object",
      "properties": {
        "street": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "gps_coordinates": {
          "type": "object",
          "properties": {
            "lat": {
              "type": "number"
            },
            "lng": {
              "type": "number"
            }
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "terminated",
        "pending_activation"
      ],
      "default": "pending_activation"
    },
    "billing_type": {
      "type": "string",
      "enum": [
        "prepaid",
        "postpaid",
        "payg"
      ],
      "default": "prepaid"
    },
    "current_plan_id": {
      "type": "string"
    },
    "ont_id": {
      "type": "string"
    },
    "account_balance": {
      "type": "number",
      "default": 0
    },
    "total_spent": {
      "type": "number",
      "default": 0
    },
    "activation_date": {
      "type": "string",
      "format": "date"
    },
    "last_payment_date": {
      "type": "string",
      "format": "date"
    },
    "churn_risk_score": {
      "type": "number",
      "description": "AI-calculated churn risk 0-100"
    },
    "customer_segment": {
      "type": "string",
      "enum": [
        "premium",
        "standard",
        "budget",
        "new",
        "at_risk"
      ]
    },
    "notes": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "first_name",
    "last_name",
    "phone",
    "customer_type"
  ]
}