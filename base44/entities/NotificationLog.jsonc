{
  "name": "NotificationLog",
  "type": "object",
  "properties": {
    "notification_id": {
      "type": "string",
      "description": "Unique notification identifier"
    },
    "customer_id": {
      "type": "string",
      "description": "Target customer"
    },
    "type": {
      "type": "string",
      "enum": [
        "email",
        "sms",
        "push"
      ],
      "description": "Notification channel"
    },
    "template_key": {
      "type": "string",
      "description": "Template identifier used"
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "fr"
      ],
      "description": "Language used for this notification"
    },
    "subject": {
      "type": "string",
      "description": "Email subject or notification title"
    },
    "body": {
      "type": "string",
      "description": "Notification content"
    },
    "recipient": {
      "type": "string",
      "description": "Email address or phone number"
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "failed",
        "pending"
      ],
      "default": "pending"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "error_message": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "description": "Additional context like ticket_id, invoice_id, etc."
    }
  },
  "required": [
    "customer_id",
    "type",
    "template_key",
    "language"
  ]
}